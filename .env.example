# StockPulse Client-side Environment Variables (Vite)
# Data Provider: "mock" (default, 30 stocks + 12 coins) or "real" (CoinGecko + stocks API via proxy)
VITE_DATA_PROVIDER=mock

# Price Stream Provider: "simulated" (default, ±0.3% drift every 2s) or "binance" (real public WebSocket)
VITE_STREAM_PROVIDER=simulated

# Mock Error Rate: 0 (default, no errors) to 1 (all mock calls fail)
VITE_MOCK_ERROR_RATE=0

# Demo Mode: "true" (default) or "false"
VITE_ENABLE_DEMO_MODE=true

# Serverless Proxy Server-side Environment Variables (Vercel / Node)
# WARNING: Keep empty in .env.example. NEVER commit real API keys or expose to client bundle.
COINGECKO_API_KEY=
STOCKS_API_KEY=
LLM_API_KEY=
RESEND_API_KEY=
